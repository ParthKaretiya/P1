# Server Port
PORT=5000

# Node environment (development / production)
NODE_ENV=development

# MongoDB Atlas Connection String
MONGO_URI=your_mongodb_connection_string

# Company Email Address (receives incoming student enquiry notifications)
COMPANY_EMAIL=your_company_email@example.com

# Resend Email API (https://resend.com)
# Get the key from Resend Dashboard -> API Keys -> Create API Key.
# FROM_EMAIL must be an address on a domain verified in Resend -> Domains
# (e.g. noreply@nirayush.com). Do NOT use gmail.com or onboarding@resend.dev in production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@nirayush.com

# Allowed CORS Origin for React Frontend (no trailing slash)
CLIENT_URL=http://localhost:5173

# Public reachable URL of this backend (Render provides RENDER_EXTERNAL_URL automatically).
# Used for keep-alive self-pings; no trailing slash.
BACKEND_URL=http://localhost:5000

# Secret key for /api/enquiry/email-debug endpoint.
# Set a long random value in production; leave empty to disable the debug endpoint.
EMAIL_DEBUG_KEY=
