# Server Port
PORT=5000

# Node environment (development / production)
NODE_ENV=development

# MongoDB Atlas Connection String (use either MONGO_URI or MONGODB_URI)
MONGO_URI=your_mongodb_connection_string
MONGODB_URI=your_mongodb_connection_string

# Company Email Address (receives incoming student enquiry notifications)
COMPANY_EMAIL=your_company_email@example.com

# Nodemailer / SMTP Configuration (Brevo SMTP Relay)
# SMTP_USER/SMTP_PASS come from Brevo -> SMTP & API -> SMTP keys
# FROM_EMAIL must be a verified sender in Brevo -> Senders & Domains
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
FROM_EMAIL=your_verified_sender@example.com

# Allowed CORS Origin for React Frontend (no trailing slash)
CLIENT_URL=http://localhost:5173

# Public reachable URL of this backend (Render provides RENDER_EXTERNAL_URL automatically).
# Used for keep-alive self-pings; no trailing slash.
BACKEND_URL=http://localhost:5000

# Secret key for /api/enquiry/email-debug endpoint.
# Set a long random value in production; leave empty to disable the debug endpoint.
EMAIL_DEBUG_KEY=
